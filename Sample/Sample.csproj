<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-android37.0</TargetFramework>
    <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationId>com.companyname.Sample</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\VpnHood.AppLib.Ads.Chartboost.Android\VpnHood.AppLib.Ads.Chartboost.Android.csproj" />
  </ItemGroup>

	<!-- The ad ids, one value per file in the private .user folder beside this repo
	     (.user/ad/Chartboost): embedded by file name, never in git. -->
	<PropertyGroup>
		<VhUserDir Condition="'$(VhUserDir)' == ''">$(MSBuildThisFileDirectory)..\..\.user</VhUserDir>
	</PropertyGroup>
	<ItemGroup>
		<EmbeddedResource Include="$(VhUserDir)\ad\Chartboost\*.txt" LogicalName="%(Filename)%(Extension)" Visible="false" />
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<PublishTrimmed>True</PublishTrimmed>
		<RunAOTCompilation>True</RunAOTCompilation>
		<RuntimeIdentifiers>android-arm64;android-x64;android-arm</RuntimeIdentifiers>
	</PropertyGroup>

</Project>